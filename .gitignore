# 本地环境与密钥——绝不提交
config.json
mcp/artboard-mcp/.bridge-session.json  # 含一次性会话 token(运行态,绝不入库)
assets/icons-cache/  # 按需缓存,可随时重建(不算库存)

__pycache__/
*.pyc
.DS_Store
Thumbs.db
dist/

# PyInstaller 构建残留(打包 config-editor 时产生)
.build/
.pkgtest/
*.spec

# 展示样例工程文件只留本地,GitHub 仅保留成图
assets/cases/show2-*.html

# ---------------------------------------------------------------
# 过程性文档:只留本地,不进仓库
# 仓库只放"实际性工作内容 + 必备指导使用文档"
#   docs/adr/          架构决策记录(开发过程留档,使用技能不需要)
#   docs/ITERATION.md  迭代台账(历史缺陷、待办、踩坑记录)
#   docs/review/       技能审查报告(一次性快照)
# 注意:gitignore 不支持行尾注释,路径必须独占一行
# ---------------------------------------------------------------
docs/adr/
docs/ITERATION.md
docs/review/
